{
  "name": "susfs-studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "biome check . && tsc --noEmit && vitest run",
    "test:e2e": "playwright test tests/studio.spec.ts",
    "test:static": "vite build --mode development && playwright test tests/static-policy.spec.ts"
  },
  "dependencies": {
    "@mantine/core": "8.3.14",
    "@mantine/hooks": "8.3.14",
    "@material/material-color-utilities": "0.4.0",
    "lossless-json": "4.3.0",
    "lucide-react": "0.468.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@biomejs/biome": "2.3.11",
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
